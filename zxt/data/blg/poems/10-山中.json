    },
    {
      "text": "天寒红叶稀",
      "pinyin": "tiān hán hóng yè xī",
      "cn": "天气寒冷，红叶也稀疏了",
      "en": "As weather turns cold, red leaves become sparse in sight.",
      "image": "/assets/blg/poems/p10_l2.webp"
    },
    {
      "text": "山路元无雨",
      "pinyin": "shān lù yuán wú yǔ",
      "cn": "山路本来就没有下雨",
      "en": "On the mountain path indeed there has been no rain,",
      "image": "/assets/blg/poems/p10_l3.webp"
    },
    {
      "text": "空翠湿人衣",
      "pinyin": "kōng cuì shī rén yī",
      "cn": "那浓郁的山色却润湿了行人的衣裳",
      "en": "Yet lush mountain green moistens one's clothes again.",
      "image": "/assets/blg/poems/p10_l4.webp"
    }

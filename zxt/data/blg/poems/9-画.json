  "lines": [
    {
      "text": "远看山有色",
      "pinyin": "yuǎn kàn shān yǒu sè",
      "cn": "远看山峰色彩明丽",
      "en": "Seen from afar, the mountains possess vivid color,",
      "image": "/assets/blg/poems/p9_l1.webp"
    },
    {
      "text": "近听水无声",
      "pinyin": "jìn tīng shuǐ wú shēng",
      "cn": "近听流水却悄然无声",
      "en": "Heard up close, the water makes no sound.",
      "image": "/assets/blg/poems/p9_l2.webp"
    },
    {
      "text": "春去花还在",
      "pinyin": "chūn qù huā hái zài",
      "cn": "春天过去了花朵依然开放",
      "en": "Spring has gone, yet the flowers still remain,",
      "image": "/assets/blg/poems/p9_l3.webp"
    },
    {
      "text": "人来鸟不惊",
      "pinyin": "rén lái niǎo bù jīng",
      "cn": "人走近了鸟儿却不惊飞",
      "en": "A person comes near, yet the birds are not startled.",
      "image": "/assets/blg/poems/p9_l4.webp"
    }
  ],

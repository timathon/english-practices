    },
    {
      "text": "弹琴复长啸",
      "pinyin": "tán qín fù cháng xiào",
      "cn": "一边弹琴一边又长长地啸歌",
      "en": "Playing the zither and whistling long.",
      "image": "/assets/blg/poems/p15_l2.webp"
    },
    {
      "text": "深林人不知",
      "pinyin": "shēn lín rén bù zhī",
      "cn": "这深邃的竹林中无人知晓",
      "en": "Deep in the woods where no one knows,",
      "image": "/assets/blg/poems/p15_l3.webp"
    },
    {
      "text": "明月来相照",
      "pinyin": "míng yuè lái xiāng zhào",
      "cn": "只有那一轮明月来陪伴照耀",
      "en": "Only the bright moon comes to shine upon me.",
      "image": "/assets/blg/poems/p15_l4.webp"
    }
  ],

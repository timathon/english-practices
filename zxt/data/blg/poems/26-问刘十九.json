    {
      "text": "绿蚁新醅酒",
      "pinyin": "lǜ yǐ xīn pēi jiǔ",
      "cn": "新酿造的米酒，酒面浮着绿色的泡沫，像微小的蚂蚁",
      "en": "Green-scummed new-brewed wine sparkling bright,",
      "image": "/assets/blg/poems/p26_l1.webp"
    },
    {
      "text": "红泥小火炉",
      "pinyin": "hóng ní xiǎo huǒ lú",
      "cn": "用红泥砌成的小巧火炉正烧得通红",
      "en": "A small red-clay stove glows in the night.",
      "image": "/assets/blg/poems/p26_l2.webp"
    },
    {
      "text": "晚来天欲雪",
      "pinyin": "wǎn lái tiān yù xuě",
      "cn": "天色已晚，看样子马上就要下雪了",
      "en": "Evening approaches, and snow is in the air—",
      "image": "/assets/blg/poems/p26_l3.webp"
    },
    {
      "text": "能饮一杯无",
      "pinyin": "néng yǐn yī bēi wú",
      "cn": "能否留下来一起喝上一杯呢？",
      "en": "Could you come drink a cup, if you care?",
      "image": "/assets/blg/poems/p26_l4.webp"
    }
  ],

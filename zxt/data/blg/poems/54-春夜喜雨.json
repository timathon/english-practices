{
  "id": 54,
  "title": "春夜喜雨",
  "dynasty": "唐",
  "author": "杜甫",
  "theme": "咏物写景 (Scenery & Nature)",
  "keywords": [
    "好雨",
    "润物",
    "花重",
    "锦官城"
  ],
  "lines": [
    {
      "text": "好雨知时节",
      "pinyin": "hǎo yǔ zhī shí jié",
      "cn": "应时而下的好雨，似乎懂得节气",
      "en": "Good rain knows its proper season,",
      "image": "/assets/blg/poems/p54_l1.webp"
    },
    {
      "text": "当春乃发生",
      "pinyin": "dāng chūn nǎi fā shēng",
      "cn": "在春天万物萌生的时候悄然而至",
      "en": "And comes when spring is here.",
      "image": "/assets/blg/poems/p54_l2.webp"
    },
    {
      "text": "随风潜入夜",
      "pinyin": "suí fēng qián rù yè",
      "cn": "伴随着和风在夜里悄悄潜入",
      "en": "It steals into the night with wind,",
      "image": "/assets/blg/poems/p54_l3.webp"
    },
    {
      "text": "润物细无声",
      "pinyin": "rùn wù xì wú shēng",
      "cn": "细密无声地滋润着万物",
      "en": "And moistens things quietly, soundlessly.",
      "image": "/assets/blg/poems/p54_l4.webp"
    },
    {
      "text": "野径云俱黑",
      "pinyin": "yě jìng yún jù hēi",
      "cn": "田野小径的天空全被乌云笼罩",
      "en": "Wild paths and clouds are dark together,",
      "image": "/assets/blg/poems/p54_l5.webp"
    },
    {
      "text": "江船火独明",
      "pinyin": "jiāng chuán huǒ dú míng",
      "cn": "只有江中船上的灯火分外明亮",
      "en": "Only boat fires on the river burn bright.",
      "image": "/assets/blg/poems/p54_l6.webp"
    },
    {
      "text": "晓看红湿处",
      "pinyin": "xiǎo kàn hóng shī chù",
      "cn": "天亮后看那红花沾湿的地方",
      "en": "At dawn, looking where the red is wet,",
      "image": "/assets/blg/poems/p54_l7.webp"
    },
    {
      "text": "花重锦官城",
      "pinyin": "huā zhòng jǐn guān chéng",
      "cn": "锦官城里到处都是沉甸甸的花朵",
      "en": "Flowers weigh heavy across Brocade City.",
      "image": "/assets/blg/poems/p54_l8.webp"
    }
  ],

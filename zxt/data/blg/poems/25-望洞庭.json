  "lines": [
    {
      "text": "湖光秋月两相和",
      "pinyin": "hú guāng qiū yuè liǎng xiāng hé",
      "cn": "洞庭湖的水光与秋月交相辉映，显得分外和谐",
      "en": "The lake light and the autumn moon harmonize with each other,",
      "image": "/assets/blg/poems/p25_l1.webp"
    },
    {
      "text": "潭面无风镜未磨",
      "pinyin": "tán miàn wú fēng jìng wèi mó",
      "cn": "水面上一点风也没有，就像一面没有磨过的铜镜",
      "en": "The surface of the pool is windless, like an unpolished mirror.",
      "image": "/assets/blg/poems/p25_l2.webp"
    },
    {
      "text": "遥望洞庭山水翠",
      "pinyin": "yáo wàng dòng tíng shān shuǐ cuì",
      "cn": "远远望去洞庭湖的山水一片青翠",
      "en": "Looking afar, the mountains and waters of Dongting are lush and green,",
      "image": "/assets/blg/poems/p25_l3.webp"
    },
    {
      "text": "白银盘里一青螺",
      "pinyin": "bái yín pán lǐ yī qīng luó",
      "cn": "就像在白银盘里盛放着一颗青螺",
      "en": "Like a green snail shell resting in a silver platter.",
      "image": "/assets/blg/poems/p25_l4.webp"
    }
  ],

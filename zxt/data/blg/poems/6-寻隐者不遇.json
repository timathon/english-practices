  "lines": [
    {
      "text": "松下问童子",
      "pinyin": "sōng xià wèn tóng zǐ",
      "cn": "在苍松树下询问童子",
      "en": "Beneath the pine trees, I ask the young boy,",
      "image": "/assets/blg/poems/p6_l1.webp"
    },
    {
      "text": "言师采药去",
      "pinyin": "yán shī cǎi yào qù",
      "cn": "（童子）回答说师父采药去了",
      "en": "He says his master has gone to gather herbs,",
      "image": "/assets/blg/poems/p6_l2.webp"
    },
    {
      "text": "只在此山中",
      "pinyin": "zhǐ zài cǐ shān zhōng",
      "cn": "只在这座大山之中",
      "en": "Right here within this mountain, deep and vast,",
      "image": "/assets/blg/poems/p6_l3.webp"
    },
    {
      "text": "云深不知处",
      "pinyin": "yún shēn bù zhī chù",
      "cn": "云雾深处不知道他在哪里",
      "en": "Yet clouds are so deep, I know not where he bides.",
      "image": "/assets/blg/poems/p6_l4.webp"
    }
  ],

    {
      "text": "众鸟高飞尽",
      "pinyin": "zhòng niǎo gāo fēi jìn",
      "cn": "群鸟高飞远去，看不见了",
      "en": "All the birds have flown high and away,",
      "image": "/assets/blg/poems/p12_l1.webp"
    },
    {
      "text": "孤云独去闲",
      "pinyin": "gū yún dú qù xián",
      "cn": "孤单的云彩独自飘荡，悠闲自在",
      "en": "A single cloud drifts away alone, leisurely.",
      "image": "/assets/blg/poems/p12_l2.webp"
    },
    {
      "text": "相看两不厌",
      "pinyin": "xiāng kàn liǎng bù yàn",
      "cn": "互相看着，谁也不会觉得厌烦",
      "en": "We look at each other, never tiring of the sight,",
      "image": "/assets/blg/poems/p12_l3.webp"
    },
    {
      "text": "只有敬亭山",
      "pinyin": "zhī yǒu jìng tíng shān",
      "cn": "只有我和这敬亭山了",
      "en": "Only I and Jingting Mountain remain.",
      "image": "/assets/blg/poems/p12_l4.webp"
    }
  ],

  "lines": [
    {
      "text": "迟日江山丽",
      "pinyin": "chí rì jiāng shān lì",
      "cn": "沐浴在春日暖阳中，江山显得格外秀丽",
      "en": "Under the lingering spring sun, the land shines with beauty,",
      "image": "/assets/blg/poems/p35_l1.webp"
    },
    {
      "text": "春风花草香",
      "pinyin": "chūn fēng huā cǎo xiāng",
      "cn": "和煦的春风吹拂，送来花草的清香",
      "en": "A gentle spring breeze wafts the sweet aroma of flora.",
      "image": "/assets/blg/poems/p35_l2.webp"
    },
    {
      "text": "泥融飞燕子",
      "pinyin": "ní róng fēi yàn zǐ",
      "cn": "冻泥融化变软，燕子欢快地衔泥筑巢",
      "en": "The thawed mud softens as swallows dart to build their nests,",
      "image": "/assets/blg/poems/p35_l3.webp"
    },
    {
      "text": "沙暖睡鸳鸯",
      "pinyin": "shā nuǎn shuì yuān yāng",
      "cn": "沙滩被阳光晒得暖洋洋的，鸳鸯静静地在上面安睡",
      "en": "And mandarin ducks rest peacefully upon the sun-warmed sand.",
      "image": "/assets/blg/poems/p35_l4.webp"
    }
  ],

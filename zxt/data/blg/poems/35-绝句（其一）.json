    },
    {
      "text": "春风花草香",
      "pinyin": "chūn fēng huā cǎo xiāng",
      "cn": "春风吹拂，送来花草的芬芳",
      "en": "And the spring breeze carries the fragrance of flowers and grass.",
      "image": "/assets/blg/poems/p35_l2.webp"
    },
    {
      "text": "泥融飞燕子",
      "pinyin": "ní róng fēi yàn zi",
      "cn": "泥土湿润，燕子正飞来飞去衔泥筑巢",
      "en": "The soil is moist as swallows fly back and forth,",
      "image": "/assets/blg/poems/p35_l3.webp"
    },
    {
      "text": "沙沙暖睡鸳鸯",
      "pinyin": "shā nuǎn shuì yuān yāng",
      "cn": "沙子温暖，美丽的鸳鸯在沙滩上静静安睡",
      "en": "While warm sand provides a cozy spot for mandarin ducks to sleep.",
      "image": "/assets/blg/poems/p35_l4.webp"
    }
  ],

  "lines": [
    {
      "text": "山际见来烟",
      "pinyin": "shān jì jiàn lái yān",
      "cn": "山与天相接的地方升起阵阵烟云",
      "en": "Amid the mountains, coming smoke is seen,",
      "image": "/assets/blg/poems/p13_l1.webp"
    },
    {
      "text": "竹中窥落日",
      "pinyin": "zhú zhōng kuī luò rì",
      "cn": "从茂密的竹林缝隙中窥见缓缓下沉的落日",
      "en": "Through dense bamboo, the setting sun is seen.",
      "image": "/assets/blg/poems/p13_l2.webp"
    },
    {
      "text": "鸟向檐上飞",
      "pinyin": "niǎo xiàng yán shàng fēi",
      "cn": "山鸟欢快地向着屋檐上方飞翔",
      "en": "Birds fly up toward the cottage eaves,",
      "image": "/assets/blg/poems/p13_l3.webp"
    },
    {
      "text": "云从窗里出",
      "pinyin": "yún cóng chuāng lǐ chū",
      "cn": "悠闲的白云竟然从敞开的窗户里飘出",
      "en": "While clouds drift gently from the window sill.",
      "image": "/assets/blg/poems/p13_l4.webp"
    }
  ],

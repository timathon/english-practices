  "lines": [
    {
      "text": "山际见来烟",
      "pinyin": "shān jì jiàn lái yān",
      "cn": "山际飘来阵阵云烟",
      "en": "Amid the mountains, coming smoke is seen,",
      "image": "/assets/blg/poems/p13_l1.webp"
    },
    {
      "text": "中宫中云气飞",
      "pinyin": "zhōng gōng zhōng yún qì fēi",
      "cn": "林中云气缭绕飞腾",
      "en": "Clouds fly and drift the quiet woods between.",
      "image": "/assets/blg/poems/p13_l2.webp"
    },
    {
      "text": "鸟道上相逢",
      "pinyin": "niǎo dào shàng xiāng féng",
      "cn": "在鸟雀飞过的小路上相逢",
      "en": "On paths for birds, we chance to meet and greet,",
      "image": "/assets/blg/poems/p13_l3.webp"
    },
    {
      "text": "云林窗下期",
      "pinyin": "yún lín chuāng xià qī",
      "cn": "在云林窗下相互期约",
      "en": "By cloud-veiled windows where our fancies meet.",
      "image": "/assets/blg/poems/p13_l4.webp"
    }
  ],

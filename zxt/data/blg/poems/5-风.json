{
  "id": 5,
  "title": "风",
  "dynasty": "唐",
  "author": "李峤",
  "theme": "自然 (Nature)",
  "keywords": [
    "风",
    "秋叶",
    "江水"
  ],
  "cn": "风能吹落秋天的树叶，也能吹开春天美丽的花。风刮过江面能掀千尺巨浪，吹进竹林又能使万竹倾斜。",
  "en": "Wind can shake down the leaves of autumn, and open the beautiful flowers of spring. Passing over the river it creates thousand-foot waves, and entering the bamboo forest it bends ten thousand stalks.",
  "lines": [
    {
      "text": "解落三秋叶",
      "pinyin": "jiě luò sān qiū yè",
      "cn": "风能吹落秋天的树叶",
      "en": "Wind can shake down autumn leaves,",
      "image": "/assets/blg/poems/p5_l1.webp"
    },
    {
      "text": "能开二月花",
      "pinyin": "néng kāi èr yuè huā",
      "cn": "也能吹开春天美丽的花",
      "en": "And open beautiful spring flowers,",
      "image": "/assets/blg/poems/p5_l2.webp"
    },
    {
      "text": "过江千尺浪",
      "pinyin": "guò jiāng qiān chǐ làng",
      "cn": "风刮过江面能掀千尺巨浪",
      "en": "Passing over the river it creates thousand-foot waves,",
      "image": "/assets/blg/poems/p5_l3.webp"
    },
    {
      "text": "入竹万竿斜",
      "pinyin": "rù zhú wàn gān xié",
      "cn": "吹进竹林又能使万竹倾斜",
      "en": "And entering the bamboo forest it bends ten thousand stalks.",
      "image": "/assets/blg/poems/p5_l4.webp"
    }
  ],

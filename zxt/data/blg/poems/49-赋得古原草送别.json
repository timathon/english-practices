  "lines": [
    {
      "text": "离离原上草",
      "pinyin": "lí lí yuán shàng cǎo",
      "cn": "古原上的野草长得茂盛生机勃勃",
      "en": "Lush and luxuriant grow the grasses on the ancient plain,",
      "image": "/assets/blg/poems/p49_l1.webp"
    },
    {
      "text": "一岁一枯荣",
      "pinyin": "yī suì yī kū róng",
      "cn": "每年枯萎一次，又繁荣生长一次",
      "en": "Withering and flourishing year after year in their cycle.",
      "image": "/assets/blg/poems/p49_l2.webp"
    },
    {
      "text": "野火烧不尽",
      "pinyin": "yě huǒ shāo bù jìn",
      "cn": "野火无法把它们全部烧尽",
      "en": "Wildfires cannot burn them away completely,",
      "image": "/assets/blg/poems/p49_l3.webp"
    },
    {
      "text": "春风吹又生",
      "pinyin": "chūn fēng chuī yòu shēng",
      "cn": "春风一吹它们又生机勃勃地生长起来",
      "en": "Spring breezes blow and they grow back to life once again.",
      "image": "/assets/blg/poems/p49_l4.webp"
    }
  ],

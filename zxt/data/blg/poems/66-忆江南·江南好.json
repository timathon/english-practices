  "lines": [
    {
      "text": "江南好",
      "pinyin": "jiāng nán hǎo",
      "cn": "江南好，风景美不胜收",
      "en": "How splendid is the Southland,",
      "image": "/assets/blg/poems/p66_l1.webp"
    },
    {
      "text": "风景旧曾谙",
      "pinyin": "fēng jǐng jiù céng ān",
      "cn": "那里的秀丽风光我曾经十分熟悉",
      "en": "Its charming scenery I have known so well of old.",
      "image": "/assets/blg/poems/p66_l2.webp"
    },
    {
      "text": "日出江花红胜火",
      "pinyin": "rì chū jiāng huā hóng shèng huǒ",
      "cn": "太阳升起时，江畔红花比燃烧的火焰还要红艳",
      "en": "At sunrise, riverside blossoms glow redder than flames,",
      "image": "/assets/blg/poems/p66_l3.webp"
    },
    {
      "text": "春来江水绿如蓝",
      "pinyin": "chūn lái jiāng shuǐ lǜ rú lán",
      "cn": "春天到来时，碧绿的江水宛如蓝草染成一般澄澈",
      "en": "Come spring, river waters shimmer emerald as indigo dye.",
      "image": "/assets/blg/poems/p66_l4.webp"
    },
    {
      "text": "能不忆江南",
      "pinyin": "néng bù yì jiāng nán",
      "cn": "怎能不令人长久怀念江南呢？",
      "en": "How could one ever keep from yearning for the Southland?",
      "image": "/assets/blg/poems/p66_l5.webp"
    }
  ],

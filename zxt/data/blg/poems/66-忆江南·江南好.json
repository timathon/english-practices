    {
      "text": "江南好",
      "pinyin": "jiāng nán hǎo",
      "cn": "江南的风景多么美好",
      "en": "Jiangnan is truly wonderful,",
      "image": "/assets/blg/poems/p66_l1.webp"
    },
    {
      "text": "风景旧曾谙",
      "pinyin": "fēng jǐng jiù céng ān",
      "cn": "这里的风景我以前非常熟悉",
      "en": "Its scenery is well-known to me of old.",
      "image": "/assets/blg/poems/p66_l2.webp"
    },
    {
      "text": "日出江花红胜火",
      "pinyin": "rì chū jiāng huā hóng shèng huǒ",
      "cn": "太阳升起时江边的花朵比火还要红",
      "en": "At sunrise, riverside flowers are redder than fire,",
      "image": "/assets/blg/poems/p66_l3.webp"
    },
    {
      "text": "春来江水绿如蓝",
      "pinyin": "chūn lái jiāng shuǐ lǜ rú lán",
      "cn": "春天到来时江水碧绿像青蓝色的染料",
      "en": "In spring, the river water is as green as blue dye.",
      "image": "/assets/blg/poems/p66_l4.webp"
    }
  ],

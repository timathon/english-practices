  "lines": [
    {
      "text": "故国三千里",
      "pinyin": "gù guó sān qiān lǐ",
      "cn": "故乡远在三千里之外",
      "en": "My homeland lies three thousand miles away,",
      "image": "/assets/blg/poems/p21_l1.webp"
    },
    {
      "text": "深宫二十年",
      "pinyin": "shēn gōng èr shí nián",
      "cn": "幽禁深宫之中已经二十年",
      "en": "And I have spent twenty years in this deep palace.",
      "image": "/assets/blg/poems/p21_l2.webp"
    },
    {
      "text": "一声何满子",
      "pinyin": "yī shēng hé mǎn zǐ",
      "cn": "猛听得一曲凄凉的《何满子》",
      "en": "Hearing a single strain of 'He Man Zi',",
      "image": "/assets/blg/poems/p21_l3.webp"
    },
    {
      "text": "双泪落君前",
      "pinyin": "shuāng lèi luò jūn qián",
      "cn": "双行热泪不由得落在国君面前",
      "en": "My twin tears fall right before the sovereign's face.",
      "image": "/assets/blg/poems/p21_l4.webp"
    }
  ],

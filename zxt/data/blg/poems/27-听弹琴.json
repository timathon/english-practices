  "lines": [
    {
      "text": "泠泠七弦上",
      "pinyin": "líng líng qī xián shàng",
      "cn": "清脆悦耳的琴声从七弦琴上奏出",
      "en": "Clear and crisp notes flow from the seven-stringed zither,",
      "image": "/assets/blg/poems/p27_l1.webp"
    },
    {
      "text": "静听松风寒",
      "pinyin": "jìng tīng sōng fēng hán",
      "cn": "静静倾听，仿佛听见了松林间的阵阵寒风",
      "en": "Quietly listening, I hear the chill wind sighing through the pines.",
      "image": "/assets/blg/poems/p27_l2.webp"
    },
    {
      "text": "古调虽自爱",
      "pinyin": "gǔ diào suī zì ài",
      "cn": "古老的曲调虽然让人分外喜爱",
      "en": "Though I deeply cherish these ancient melodies,",
      "image": "/assets/blg/poems/p27_l3.webp"
    },
    {
      "text": "今人多不弹",
      "pinyin": "jīn rén duō bù tán",
      "cn": "但如今的人们大多已经不再弹奏了",
      "en": "Few people nowadays still play them.",
      "image": "/assets/blg/poems/p27_l4.webp"
    }
  ],

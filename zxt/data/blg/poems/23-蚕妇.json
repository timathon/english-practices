  "lines": [
    {
      "text": "昨日入城市",
      "pinyin": "zuó rì rù chéng shì",
      "cn": "昨天进城去卖丝",
      "en": "Yesterday I went into the city markets,",
      "image": "/assets/blg/poems/p23_l1.webp"
    },
    {
      "text": "归来泪满巾",
      "pinyin": "guī lái lèi mǎn jīn",
      "cn": "回到家里眼泪浸湿了衣巾",
      "en": "Returning home, my tears soaked through my kerchief.",
      "image": "/assets/blg/poems/p23_l2.webp"
    },
    {
      "text": "遍身罗绮者",
      "pinyin": "biàn shēn luó qǐ zhě",
      "cn": "那些满身穿着华丽绫罗绸缎的富贵人家",
      "en": "Those clothed from head to toe in fine silks,",
      "image": "/assets/blg/poems/p23_l3.webp"
    },
    {
      "text": "不是养蚕人",
      "pinyin": "bù shì yǎng cán rén",
      "cn": "没有一个是辛苦养蚕的劳动者",
      "en": "Are never the ones who raise the silkworms.",
      "image": "/assets/blg/poems/p23_l4.webp"
    }
  ],

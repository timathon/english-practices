  "lines": [
    {
      "text": "昨日入城市",
      "pinyin": "zuó rì rù chéng shì",
      "cn": "昨天到集市上去",
      "en": "Yesterday I went into the town,",
      "image": "/assets/blg/poems/p23_l1.webp"
    },
    {
      "text": "归来衣著贫",
      "pinyin": "guī lái yī zhuó pín",
      "cn": "回来看看自己身上的衣服依旧贫寒",
      "en": "And returned home realizing how poorly I am dressed.",
      "image": "/assets/blg/poems/p23_l2.webp"
    },
    {
      "text": "身得几厘丝",
      "pinyin": "shēn dé jǐ lí sī",
      "cn": "身上辛辛苦苦能得到几缕蚕丝",
      "en": "Through my body's toil, how many threads of silk do I get?",
      "image": "/assets/blg/poems/p23_l3.webp"
    },
    {
      "text": "却穿罗绮人",
      "pinyin": "què chuān luó qǐ rén",
      "cn": "却穿在那些不劳而获的人身上",
      "en": "Yet those who wear fine silks are people who do no farm work.",
      "image": "/assets/blg/poems/p23_l4.webp"
    }
  ],

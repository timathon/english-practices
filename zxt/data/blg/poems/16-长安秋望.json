    {
      "text": "楼上残阳照",
      "pinyin": "lóu shàng cán yáng zhào",
      "cn": "楼上照耀着残阳余晖",
      "en": "The setting sun shines upon the pavilion,",
      "image": "/assets/blg/poems/p16_l1.webp"
    },
    {
      "text": "秋风满四郊",
      "pinyin": "qiū fēng mǎn sì jiāo",
      "cn": "秋风吹拂着四面郊野",
      "en": "And autumn winds fill the surrounding countryside.",
      "image": "/assets/blg/poems/p16_l2.webp"
    },
    {
      "text": "故园何处是",
      "pinyin": "gù yuán hé chù shì",
      "cn": "我的故乡究竟在何处呢",
      "en": "Where indeed is my homeland?",
      "image": "/assets/blg/poems/p16_l3.webp"
    },
    {
      "text": "归思浩无涯",
      "pinyin": "guī sī hào wú yá",
      "cn": "思乡的愁绪像江水般浩渺无边",
      "en": "My thoughts of returning are vast and boundless.",
      "image": "/assets/blg/poems/p16_l4.webp"
    }
  ],

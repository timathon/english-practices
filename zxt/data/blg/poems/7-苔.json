  "lines": [
    {
      "text": "白日不到处",
      "pinyin": "bái rì bú dào chù",
      "en": "Where the bright sun cannot reach,",
      "cn": "阳光照不到的地方，",
      "image": "/assets/blg/poems/p7_l1.webp"
    },
    {
      "text": "青春恰自来",
      "pinyin": "qīng chūn qià zì lái",
      "en": "Youthful green naturally comes forth.",
      "cn": "青翠的生命力却恰好自然生长。",
      "image": "/assets/blg/poems/p7_l2.webp"
    },
    {
      "text": "苔花如米小",
      "pinyin": "tái huā rú mǐ xiǎo",
      "en": "The moss flowers are as small as grains of rice,",
      "cn": "苔花虽然小得像米粒一样，",
      "image": "/assets/blg/poems/p7_l3.webp"
    },
    {
      "text": "也学牡丹开",
      "pinyin": "yě xué mǔ dān kāi",
      "en": "Yet they also learn to bloom like the peony.",
      "cn": "但也像牡丹一样高傲地盛开。",
      "image": "/assets/blg/poems/p7_l4.webp"
    }
  ],

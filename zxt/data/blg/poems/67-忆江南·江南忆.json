  ],
  "lines": [
    {
      "text": "江南忆",
      "pinyin": "jiāng nán yì",
      "cn": "江南的回忆啊",
      "en": "Memories of the Southland,",
      "image": "/assets/blg/poems/p67_l1.webp"
    },
    {
      "text": "最忆是杭州",
      "pinyin": "zuì yì shì háng zhōu",
      "cn": "最难忘、最怀念的就是杭州",
      "en": "Fondest of all is the memory of Hangzhou.",
      "image": "/assets/blg/poems/p67_l2.webp"
    },
    {
      "text": "山寺月中寻桂子",
      "pinyin": "shān sì yuè zhōng xún guì zǐ",
      "cn": "曾在月光下的山中古寺漫步寻觅落下的桂花",
      "en": "Seeking fallen laurel blossoms beneath moonlight in mountain temples,",
      "image": "/assets/blg/poems/p67_l3.webp"
    },
    {
      "text": "郡亭枕上看潮头",
      "pinyin": "jùn tíng zhěn shàng kàn cháo tóu",
      "cn": "曾在郡守亭台上倚枕观赏钱塘江壮丽的潮头奔涌",
      "en": "Resting on a pavilion pillow, watching surging tidal waves roll by.",
      "image": "/assets/blg/poems/p67_l4.webp"
    },
    {
      "text": "何日更重游",
      "pinyin": "hé rì gèng chóng yóu",
      "cn": "不知什么时候才能再次重游杭州呢？",
      "en": "Ah, what day may I wander there once again?",
      "image": "/assets/blg/poems/p67_l5.webp"
    }
  ],

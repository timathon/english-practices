  "lines": [
    {
      "text": "江南忆",
      "pinyin": "jiāng nán yì",
      "cn": "江南的回忆",
      "en": "Memories of Jiangnan,",
      "image": "/assets/blg/poems/p67_l1.webp"
    },
    {
      "text": "最忆是江南",
      "pinyin": "zuì yì shì jiāng nán",
      "cn": "最让人难忘的还是江南",
      "en": "Most unforgettable is Jiangnan.",
      "image": "/assets/blg/poems/p67_l2.webp"
    },
    {
      "text": "风景旧曾谙",
      "pinyin": "fēng jǐng jiù céng ān",
      "cn": "这里的风景我曾经非常熟悉",
      "en": "Its scenery I once knew so well.",
      "image": "/assets/blg/poems/p67_l3.webp"
    },
    {
      "text": "日出江花红胜火",
      "pinyin": "rì chū jiāng huā hóng shèng huǒ",
      "cn": "太阳升起时江边的花朵比火还要红",
      "en": "At sunrise river flowers are redder than fire,",
      "image": "/assets/blg/poems/p67_l4.webp"
    },
    {
      "text": "春来江水绿如蓝",
      "pinyin": "chūn lái jiāng shuǐ lǜ rú lán",
      "cn": "春天到来时碧绿的江水青绿如蓝草",
      "en": "In spring the river water is as green as blue dye.",
      "image": "/assets/blg/poems/p67_l5.webp"
    },
    {
      "text": "能不忆江南",
      "pinyin": "néng bù yì jiāng nán",
      "cn": "怎能不让人怀念江南呢",
      "en": "How can I not yearn for Jiangnan?",
      "image": "/assets/blg/poems/p67_l6.webp"
    }
  ],

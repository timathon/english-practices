  "lines": [
    {
      "text": "碧玉妆成一树高",
      "pinyin": "bì yù zhuāng chéng yī shù gāo",
      "cn": "高高的柳树长满了翠绿的新叶，如同碧玉装扮的一样",
      "en": "The tall willow is draped in green jade-like leaves,",
      "image": "/assets/blg/poems/p33_l1.webp"
    },
    {
      "text": "万条垂下绿丝绦",
      "pinyin": "wàn tiáo chuí xià lǜ sī tāo",
      "cn": "无数下垂的柳条，就像千万条绿色的丝带",
      "en": "Countless willow branches hang down like green silk ribbons.",
      "image": "/assets/blg/poems/p33_l2.webp"
    },
    {
      "text": "不知细叶谁裁出",
      "pinyin": "bù zhī xì yè shuí cái chū",
      "cn": "不知道这细细的柳叶是谁裁剪出来的呢",
      "en": "I wonder who has tailored these delicate green leaves,",
      "image": "/assets/blg/poems/p33_l3.webp"
    },
    {
      "text": "二月春风似剪刀",
      "pinyin": "èr yuè chūn fēng sì jiǎn dāo",
      "cn": "原来是二月的春风这把灵巧的剪刀剪出来的呀",
      "en": "The February spring breeze is like a pair of sharp scissors.",
      "image": "/assets/blg/poems/p33_l4.webp"
    }
  ],

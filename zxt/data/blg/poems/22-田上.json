  "lines": [
    {
      "text": "雨足高田白",
      "pinyin": "yǔ zú gāo tián bái",
      "cn": "雨水充足，高处的梯田一片水光白亮",
      "en": "Abundant rain leaves high paddies glistening white,",
      "image": "/assets/blg/poems/p22_l1.webp"
    },
    {
      "text": "披蓑半夜耕",
      "pinyin": "pī suō bàn yè gēng",
      "cn": "农夫披着蓑衣趁着半夜冒雨抢种耕作",
      "en": "Wearing a coir cape, plowing in the dead of night.",
      "image": "/assets/blg/poems/p22_l2.webp"
    },
    {
      "text": "人牛力俱尽",
      "pinyin": "rén niú lì jù jìn",
      "cn": "人和耕牛都已经精疲力竭",
      "en": "Both man and ox have spent all their strength,",
      "image": "/assets/blg/poems/p22_l3.webp"
    },
    {
      "text": "东方殊未明",
      "pinyin": "dōng fāng shū wèi míng",
      "cn": "东方的天空却还完全没有泛白破晓",
      "en": "Yet the eastern sky shows not a sliver of dawn.",
      "image": "/assets/blg/poems/p22_l4.webp"
    }
  ],

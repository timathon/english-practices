  "lines": [
    {
      "text": "浪花今日作雪飞",
      "pinyin": "làng huā jīn rì zuò xuě fēi",
      "cn": "江面上翻滚的浪花如同雪花般飞舞",
      "en": "The wave flowers today fly like snow,",
      "image": "/assets/blg/poems/p22_l1.webp"
    },
    {
      "text": "黄犊耕烟傍水归",
      "pinyin": "huáng dú gēng yān bàng shuǐ guī",
      "cn": "小牛犊在薄雾迷蒙中耕作后傍水而归",
      "en": "Yellow calves plowing in the mist return alongside the water.",
      "image": "/assets/blg/poems/p22_l2.webp"
    },
    {
      "text": "九十春光能有几",
      "pinyin": "jiǔ shí chūn guāng néng yǒu jǐ",
      "cn": "九十天的春光究竟能有多少呢",
      "en": "How much spring time of ninety days can there be?",
      "image": "/assets/blg/poems/p22_l3.webp"
    },
    {
      "text": "田家劳作不曾歇",
      "pinyin": "tián jiā láo zuò bù céng xiē",
      "cn": "农家之人的辛勤劳作从未曾停歇",
      "en": "Peasant families labor without a rest.",
      "image": "/assets/blg/poems/p22_l4.webp"
    }
  ],

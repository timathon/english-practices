  "lines": [
    {
      "text": "古木阴中系短篷",
      "pinyin": "gǔ mù yīn zhōng xì duǎn péng",
      "cn": "古树的浓荫下系着一只小船",
      "en": "A small boat is moored in the shade of ancient trees,",
      "image": "/assets/blg/poems/p47_l1.webp"
    },
    {
      "text": "杖藜扶我过桥东",
      "pinyin": "zhàng lí fú wǒ guò qiáo dōng",
      "cn": "我拄着藜杖扶持着走过桥东",
      "en": "Lean on a staff, I cross to the east of the bridge.",
      "image": "/assets/blg/poems/p47_l2.webp"
    },
    {
      "text": "沾衣欲湿杏花雨",
      "pinyin": "zhān yī yù shī xìng huā yǔ",
      "cn": "沾湿衣裳的像是想要润湿杏花的春雨",
      "en": "The misty spring rain, wetting apricot blossoms and clothes,",
      "image": "/assets/blg/poems/p47_l3.webp"
    },
    {
      "text": "吹面不寒杨柳风",
      "pinyin": "chuī miàn bù hán yáng liǔ fēng",
      "cn": "吹在脸上一点也不觉得寒冷，那是拂面而过的杨柳轻风",
      "en": "Gentle as the willow breeze that blows softly on the face, refreshing and mild.",
      "image": "/assets/blg/poems/p47_l4.webp"
    }
  ],

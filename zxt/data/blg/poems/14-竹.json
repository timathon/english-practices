  "lines": [
    {
      "text": "一节复一节",
      "pinyin": "yī jié fù yī jié",
      "cn": "竹子一节接着一节，节节挺拔向上生长",
      "en": "Joint after joint, segmented node by node,",
      "image": "/assets/blg/poems/p14_l1.webp"
    },
    {
      "text": "千枝攒万叶",
      "pinyin": "qiān zhī cuán wàn yè",
      "cn": "千百条细枝上聚集簇拥着万片翠绿的竹叶",
      "en": "A thousand slender twigs cluster ten thousand leaves.",
      "image": "/assets/blg/poems/p14_l2.webp"
    },
    {
      "text": "我自不开花",
      "pinyin": "wǒ zì bù kāi huā",
      "cn": "我自然不会像寻常花木那样争奇斗艳开花",
      "en": "Of myself I choose never to bloom or flower,",
      "image": "/assets/blg/poems/p14_l3.webp"
    },
    {
      "text": "免撩蜂与蝶",
      "pinyin": "miǎn liáo fēng yǔ dié",
      "cn": "免得招惹蜜蜂和蝴蝶前来纠缠喧闹",
      "en": "Spared from enticing the bees and butterflies.",
      "image": "/assets/blg/poems/p14_l4.webp"
    }
  ],

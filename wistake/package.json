{
  "name": "wistake-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:all": "npm run dev --workspace=api & npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "build": "npm run build --workspace=web",
    "build:all": "npm run build --workspace=api && npm run build --workspace=web",
    "deploy:web": "npm run deploy --workspace=web",
    "deploy:api": "npm run deploy --workspace=api"
  }
}

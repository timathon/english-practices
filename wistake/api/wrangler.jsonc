{
  "name": "wistake-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wistake-db",
      "database_id": "wistake-local-db",
      "migrations_dir": "migrations"
    }
  ]
}

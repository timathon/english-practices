{
  "name": "wistake-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "wistakeapi.vibequizzing.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wistake-db",
      "database_id": "e2286915-427e-48ce-87c3-4b9da088c660",
      "migrations_dir": "migrations"
    }
  ]
}

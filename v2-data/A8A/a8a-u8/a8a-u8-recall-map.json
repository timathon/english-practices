        "children": [
          {
            "id": "g_if_future",
            "text": "Main Future, If Present (主将从现)",
            "emoji": "⏳",
            "children": [
              {
                "id": "g_if_fut_rule",
                "text": "Rule: If-clause uses simple present; main clause uses will + base verb",
                "emoji": "📌"
              },
              {
                "id": "g_if_fut_eg",
                "text": "Example: If I go there, I will try all the delicious local food",
                "emoji": "🍜"
              }
            ]
          },
          {
            "id": "g_if_modal",
            "text": "Main Modal, If Present (主情从现)",
            "emoji": "💡",
            "children": [
              {
                "id": "g_if_mod_rule",
                "text": "Rule: If-clause in present; main clause uses can / may / should / must",
                "emoji": "📌"
              },
              {
                "id": "g_if_mod_eg",
                "text": "Example: If the man has hearing difficulty, you can write things down",
                "emoji": "📝"
              }
            ]
          },
          {
            "id": "g_if_imperative",
            "text": "Main Imperative, If Present (主祈从现)",
            "emoji": "🗣️",
            "children": [
              {
                "id": "g_if_imp_rule",
                "text": "Rule: If-clause in present; main clause is an imperative sentence",
                "emoji": "📌"
              },
              {
                "id": "g_if_imp_eg",
                "text": "Example: If you can't reach her by phone, try texting",
                "emoji": "📱"
              }
            ]
          },
          {
            "id": "g_if_comma_order",
            "text": "Clause Order & Comma Usage",
            "emoji": "✏️",
            "children": [
              {
                "id": "g_if_comma_rule",
                "text": "If at front -> use comma. Main clause first -> no comma needed",
                "emoji": "🔤"
              },
              {
                "id": "g_if_comma_eg",
                "text": "Example: Texting makes things worse if you're not careful with words",
                "emoji": "💬"
              }
            ]
          }
        ]

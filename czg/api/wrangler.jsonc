{
  "name": "czg-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "czg-db",
      "database_id": "czg-local-db",
      "migrations_dir": "migrations"
    }
  ]
}
